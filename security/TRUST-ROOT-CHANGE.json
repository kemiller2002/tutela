{
  "schemaVersion": 1,
  "id": "tutela-trust-root-change",
  "version": "1.7.0",
  "protectedPaths": [
    "security/PROVENANCE-AUTHORITY.json",
    "security/TRUST-ROOT-CHANGE.json",
    "src/tutela_gate.py",
    "schemas/security-evidence.schema.json",
    "schemas/security-assessment.schema.json",
    "security/ROLE-REGISTRY.json",
    "src/tutela_trust_root.py",
    "security/SENSITIVE-DATA-RULES.json",
    "schemas/exception.schema.json",
    "schemas/verification-result.schema.json",
    "src/Tutela.Core/Json.fs",
    "src/Tutela.Core/Domain.fs",
    "src/Tutela.Core/Policy.fs",
    "src/Tutela.Core/SensitiveData.fs",
    "src/Tutela.Core/Exceptions.fs",
    "src/Tutela.Core/Validation.fs",
    "src/Tutela.Core/Gate.fs",
    "src/Tutela.Core/Verification.fs",
    "src/Tutela.Cli/Program.fs"
  ],
  "requirements": {
    "changeId": true,
    "rationale": true,
    "changedBy": true,
    "approvalsMinimum": 1,
    "independentApproval": true,
    "evidenceRequired": true,
    "previousDigestRequired": true,
    "newDigestRequired": true,
    "weakeningRequiresExplicitFlag": true,
    "approverAuthorityRequired": true,
    "weakeningAuthorityRequired": true,
    "roleMembershipSource": "security/ROLE-REGISTRY.json",
    "changedByIdentityRequired": true,
    "identityBindingRequired": true
  },
  "approvalAuthorities": [
    {
      "id": "security-reviewer",
      "roles": [
        "security-reviewer"
      ],
      "mayApprove": [
        "trust-root-change"
      ],
      "mayAuthorizeWeakening": false,
      "identityKinds": [
        "human",
        "agent"
      ]
    },
    {
      "id": "security-owner",
      "roles": [
        "security-owner"
      ],
      "mayApprove": [
        "trust-root-change"
      ],
      "mayAuthorizeWeakening": true,
      "identityKinds": [
        "human"
      ]
    }
  ],
  "transitionRecord": {
    "directory": "security/transitions",
    "digestAlgorithm": "sha256",
    "pathCoverage": "exact",
    "baseAndHeadContentBinding": true,
    "protectedSetSource": "union-of-base-and-head",
    "removalIsProtectedChange": true,
    "removalApprovalRequiresWeakeningAuthority": true,
    "approvalAuthoritySource": "base"
  }
}
