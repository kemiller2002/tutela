{"$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Tutela Security Exception", "description": "An exception satisfies a gate only when the F# gate honors it: approved, current (createdAt <= evaluation < expiresAt), complete, approved by a verified human identity distinct from requestedByIdentity that holds security-owner in security/ROLE-REGISTRY.json. Role claims in the assessment are not authoritative. See docs/VERIFICATION-CONTRACT.md.", "type": "object", "required": ["id", "scope", "covers", "rationale", "approver", "approved", "createdAt", "expiresAt", "compensatingControls", "evidence", "requestedByIdentity", "approverIdentity"], "$defs": {"boundIdentity": {"type": "object", "required": ["kind", "provider", "subjectId", "bindingVerified", "bindingEvidence"], "properties": {"kind": {"enum": ["human", "agent", "workflow"]}, "provider": {"const": "github"}, "subjectId": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"}, "login": {"type": "string", "description": "Display only; never confers identity."}, "bindingVerified": {"const": true}, "bindingEvidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kind", "issuer", "sourceRef", "observedAt"], "properties": {"kind": {"const": "platform-api-observation"}, "issuer": {"const": "github"}, "sourceRef": {"type": "string", "minLength": 1}, "observedAt": {"type": "string", "format": "date-time"}}}}}}}, "properties": {"id": {"type": "string", "pattern": "^SEC-EXC-[0-9]{3,}$"}, "scope": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "covers": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "description": "Invariant or unknown-effect ids this exception accepts."}, "rationale": {"type": "string", "minLength": 1}, "approver": {"type": "string", "minLength": 1, "description": "Display name; non-authoritative."}, "approved": {"const": true}, "createdAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"}, "compensatingControls": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "owner": {"type": "string"}, "requestedByIdentity": {"$ref": "#/$defs/boundIdentity"}, "approverIdentity": {"$ref": "#/$defs/boundIdentity"}}, "additionalProperties": false}
